# Admin login
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH='$2b$12$replace-with-your-bcrypt-hash'

# Long random string for signing session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Path to your Firebase service account key (Firebase console > Project settings > Service accounts)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Set to production when deployed behind HTTPS
# NODE_ENV=production
# PORT=3000
